# Environment mode
NODE_ENV=development
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=proj_manager
POSTGRES_PORT=5432

# Database URLs
# Host machine uses localhost:<POSTGRES_PORT>:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proj_manager?schema=public"
# Inside Docker containers use postgres:5432:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/proj_manager?schema=public"

# JWT Secrets & TTLs
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_super_secure_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_super_secure_67890
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
CORS_ORIGIN=*

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
